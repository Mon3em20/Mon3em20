From 416ff8633ebc9136caee0910f28ad17c867f7a2b Mon Sep 17 00:00:00 2001
From: Claude Code <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 15:38:55 +0000
Subject: [PATCH] Untrack empty .env; add .gitignore and .env.example

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012jmRt2neznxyD9z2G1Nh7w
---
 .env         |  0
 .env.example |  3 +++
 .gitignore   | 14 ++++++++++++++
 3 files changed, 17 insertions(+)
 delete mode 100644 .env
 create mode 100644 .env.example
 create mode 100644 .gitignore

diff --git a/.env b/.env
deleted file mode 100644
index e69de29..0000000
diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..171f65b
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,3 @@
+# Copy to .env (never commit .env) and fill in your own values.
+SUPABASE_URL=
+SUPABASE_KEY=
diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..bc72759
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,14 @@
+# Secrets and local configuration
+.env
+.env.*
+!.env.example
+
+# Python
+__pycache__/
+*.pyc
+.venv/
+venv/
+
+# IDE
+.idea/
+.vscode/
-- 
2.43.0

