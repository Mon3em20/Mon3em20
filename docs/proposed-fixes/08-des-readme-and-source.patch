+# 16 round keys (48 bits each)
+round_keys = ["010101010101010101010101010101010101010101010101" for _ in range(16)]
+
+
+
+
+
+def text_to_bits(text):
+    """Convert text to a list of bits."""
+    return [int(bit) for char in text for bit in format(ord(char), '08b')]
+
+def bits_to_text(bits):
+    """Convert a list of bits to text."""
+    chars = []
+    for i in range(0, len(bits), 8):
+        byte = bits[i:i+8]
+        chars.append(chr(int(''.join(map(str, byte)), 2)))
+    return ''.join(chars)
+
+# Helper functions
+def permute(block, table):
+    """Permute the block using the specified table."""
+    return [block[i - 1] for i in table]
+
+def substitute(block):
+    """Substitute the block using the S-boxes."""
+    result = []
+    for i in range(8):
+        chunk = block[i * 6:(i + 1) * 6]
+        row = (chunk[0] << 1) + chunk[5]
+        col = (chunk[1] << 3) + (chunk[2] << 2) + (chunk[3] << 1) + chunk[4]
+        val = S_BOXES[i][row][col]
+        result += [int(bit) for bit in format(val, '04b')]
+    return result
+
+# DES Encryption with Round-by-Round Output
+def des_encrypt(block, round_keys):
+    """Encrypt a 64-bit block using DES."""
+    # Step 1: Initial Permutation (IP)
+    block = permute(block, IP)
+    print("After Initial Permutation (IP):", ''.join(map(str, block)))
+
+    # Step 2: Split into left and right halves
+    left = block[:32]
+    right = block[32:]
+    print("After Splitting into L0 and R0:")
+    print("L0:", ''.join(map(str, left)))
+    print("R0:", ''.join(map(str, right)))
+
+    # Perform 16 rounds of DES
+    for round_num in range(16):
+        print(f"\n--- Round {round_num + 1} ---")
+
+        # Step 3: Expand the right half (R0) to 48 bits
+        expanded_right = permute(right, E)
+        print(f"Expanded R{round_num}:", ''.join(map(str, expanded_right)))
+        # Step 4: XOR with the round key
+        mixed = [expanded_right[j] ^ int(round_keys[round_num][j]) for j in range(48)]
+        print("After XOR with Round Key:", ''.join(map(str, mixed)))
+
+        # Step 5: Apply S-box substitution
+        substituted = substitute(mixed)
+        print("After S-box Substitution:", ''.join(map(str, substituted)))
+
+        # Step 6: Permutation (P-box)
+        permuted = permute(substituted, P)
+        print("After Permutation (P-box):", ''.join(map(str, permuted)))
+
+        # Step 7: XOR with the left half (L0)
+        new_right = [left[j] ^ permuted[j] for j in range(32)]
+        print("After XOR with L0:", ''.join(map(str, new_right)))
+
+        # Step 8: Update halves
+        left, right = right, new_right
+        print(f"After Round {round_num + 1}:")
+        print(f"L{round_num + 1}:", ''.join(map(str, left)))
+        print(f"R{round_num + 1}:", ''.join(map(str, right)))
+
+    # Final swap and final permutation (FP)
+    block = right + left
+    print("\nAfter Final Swap:", ''.join(map(str, block)))
+    block = permute(block, FP)
+    print("After Final Permutation (FP):", ''.join(map(str, block)))
+
+    return block
+
+
+
+# CBC Mode Encryption
+def cbc_mode_encrypt(plaintext, round_keys, iv):
+    """Encrypt plaintext using DES in CBC mode."""
+    blocks = [plaintext[i:i+64] for i in range(0, len(plaintext), 64)]  # Split into 64-bit blocks
+    ciphertext = []
+    previous_block = iv
+
+    for block_num, block in enumerate(blocks):
+        print(f"\n--- Block {block_num + 1} ---")
+        print("Plaintext Block:", ''.join(map(str, block)))
+
+        # Step 1: XOR with previous ciphertext (or IV for the first block)
+        xored_block = [block[j] ^ previous_block[j] for j in range(64)]
+        print("After XOR with Previous Block/IV:", ''.join(map(str, xored_block)))
+
+        # Step 2: Encrypt using DES
+        encrypted_block = des_encrypt(xored_block, round_keys)
+        print("Encrypted Block:", ''.join(map(str, encrypted_block)))
+
+        # Step 3: Store the ciphertext and update the previous block
+        ciphertext.append(encrypted_block)
+        previous_block = encrypted_block
+
+    return ciphertext
+
+# CBC Mode Encryption
+def cbc_mode_encrypt(plaintext, round_keys, iv):
+    """Encrypt plaintext using DES in CBC mode."""
+    blocks = [plaintext[i:i+64] for i in range(0, len(plaintext), 64)]  # Split into 64-bit blocks
+    ciphertext = []
+    previous_block = iv
+
+    for block_num, block in enumerate(blocks):
+        print(f"\n--- Block {block_num + 1} ---")
+        print("Plaintext Block:", ''.join(map(str, block)))
+
+        # Step 1: XOR with previous ciphertext (or IV for the first block)
+        xored_block = [block[j] ^ previous_block[j] for j in range(64)]
+        print("After XOR with Previous Block/IV:", ''.join(map(str, xored_block)))
+
+        # Step 2: Encrypt using DES
+        encrypted_block = des_encrypt(xored_block, round_keys)
+        print("Encrypted Block:", ''.join(map(str, encrypted_block)))
+
+        # Step 3: Store the ciphertext and update the previous block
+        ciphertext.append(encrypted_block)
+        previous_block = encrypted_block
+
+    return ciphertext
+
+# Main function
+def main():
+    plaintext = "Hello DES in CBC Mode"
+    iv = [0] * 64  # Initialization vector (64 bits of zeros)
+    plaintext_bits = text_to_bits(plaintext)  # Convert plaintext to bits
+
+    # Pad plaintext if necessary
+    if len(plaintext_bits) % 64 != 0:
+        padding_length = 64 - (len(plaintext_bits) % 64)
+        plaintext_bits += [0] * padding_length
+
+    # Encrypt using CBC mode
+    ciphertext = cbc_mode_encrypt(plaintext_bits, round_keys, iv)
+
+    # Display final ciphertext
+    print("\nFinal Ciphertext (bits):")
+    c=0
+    for c, block in enumerate(ciphertext):
+        print(f'c{c}: ' + ''.join(map(str, block)))
+
+main()
